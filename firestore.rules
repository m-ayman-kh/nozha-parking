rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules → Publish.
// To add an admin: create the user in Authentication → Users, then add the email to ADMINS below.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'm.ayman.kh@gmail.com'
        ];
    }

    // All slots in one document: anyone can read (the public map), only admins can change
    match /public/slots {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['geojson', 'updatedAt', 'updatedBy'])
        && request.resource.data.geojson is string
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // Change log: admins can add and read entries, nobody can edit or delete them
    match /history/{entry} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.token.email;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
